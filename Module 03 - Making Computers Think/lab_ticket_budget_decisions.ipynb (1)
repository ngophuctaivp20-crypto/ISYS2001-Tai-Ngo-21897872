        "def classify_expense(category, amount):\n",
        "    category = category.lower()\n",
        "\n",
        "    # Sort into categories using if, elif, else, and, or\n",
        "    if category == \"housing\" or category == \"rent\" or category == \"mortgage\" or category == \"utilities\" or category == \"home insurance\":\n",
        "        group = \"Housing\"\n",
        "        low, high = 500, 1500\n",
        "    elif category == \"food\" or category == \"groceries\":\n",
        "        group = \"Food\"\n",
        "        low, high = 100, 400\n",
        "    elif category == \"transport\" or category == \"transportation\":\n",
        "        group = \"Transport\"\n",
        "        low, high = 50, 200\n",
        "    elif category == \"debt\" or category == \"debts\" or category == \"extras\":\n",
        "        group = \"Debts & Extras\"\n",
        "        low, high = 50, 300\n",
        "    elif category == \"subscriptions\" or category == \"entertainment\" or category == \"shopping\" or category == \"misc\":\n",
        "        group = \"Other\"\n",
        "        low, high = 20, 100\n",
        "    else:\n",
        "        group = \"Other\"\n",
        "        low, high = 20, 100\n",
        "\n",
        "    # React based on amount using if, elif, else, and, or\n",
        "    if amount >= high:\n",
        "        level = \"High\"\n",
        "    elif amount <= low and amount > 0:\n",
        "        level = \"Low\"\n",
        "    elif amount > low and amount < high:\n",
        "        level = \"Medium\"\n",
        "    else:\n",
        "        level = \"Invalid\"\n",
        "\n",
        "    return group, level\n",
        "\n",
        "\n",
        "# --- Interactive input loop ---\n",
        "print(\"Expense Classifier — type 'done' when finished\\n\")\n",
        "\n",
        "while True:\n",
        "    category_input = input(\"Enter expense category (e.g. housing, food, transport, debts, subscriptions): \")\n",
        "\n",
        "    if category_input.lower() == \"done\":\n",
        "        print(\"\\nFinished classifying expenses.\")\n",
        "        break\n",
        "\n",
        "    amount_input = input(\"Enter amount ($): \")\n",
        "\n",
        "    # Validate the amount is a number using try/except\n",
        "    try:\n",
        "        amount_input = float(amount_input)\n",
        "    except ValueError:\n",
        "        print(\"⚠️ Please enter a valid number for the amount.\\n\")\n",
        "        continue\n",
        "\n",
        "    group, level = classify_expense(category_input, amount_input)\n",
        "    print(f\"→ Category: {group:<15} Level: {level}\\n\")"
